{
  "name": "@micropasts/grid-ref",
  "version": "0.1.0",
  "description": "Zero-dependency JavaScript Web Components for OSGB36 British National Grid references, WGS84 conversion, precision/obfuscation badges, and SVG grid-square previews.",
  "type": "module",
  "main": "./dist/grid-ref.esm.js",
  "module": "./dist/grid-ref.esm.js",
  "unpkg": "./dist/grid-ref.iife.js",
  "jsdelivr": "./dist/grid-ref.iife.js",
  "exports": {
    ".": {
      "import": "./dist/grid-ref.esm.js",
      "default": "./src/index.js"
    },
    "./core": "./src/core.js",
    "./shadow": "./src/shadow.js",
    "./tailwind": "./src/tailwind.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "npm run build && npx serve docs",
    "prepare": "npm run build"
  },
  "keywords": [
    "osgb36",
    "national-grid",
    "grid-reference",
    "wgs84",
    "archaeology",
    "portable-antiquities",
    "web-components",
    "tailwindcss",
    "micropasts"
  ],
  "license": "MIT"
}